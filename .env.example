GATEWAY_MAX_ATTEMPTS_PER_EPISODE=8
AUTO_RECOVERY_ENABLED=true
AUTO_RECOVERY_MAX_ROUNDS=5
AUTO_RECOVERY_MAX_ACTIVE_MS=1800000
CLARIFICATIONS_ENABLED=true
API_SECRET=
ENCRYPTION_KEY=
POSTGRES_PASSWORD=
DISPATCHER_TOKEN=
GATEWAY_TOKEN=
GATEWAY_ADMIN_TOKEN=
HTTPS_PORT=3443
HTTPS_BIND_ADDRESS=0.0.0.0
BIND_ADDRESS=127.0.0.1
# Code repository host whitelist (github.com and gitlab.com are always included by default)
GIT_ALLOWED_HOSTS=gitlab.com,github.com
# Exact host:port values; HTTP still requires allowInsecureHttp on the relay.
GATEWAY_ALLOWED_HOSTS=
SPECBOARD_API_IMAGE=ghcr.io/wangyusheng1985/specboard-api:latest
SPECBOARD_GATEWAY_IMAGE=ghcr.io/wangyusheng1985/specboard-gateway:latest
SPECBOARD_AGENT_IMAGE=ghcr.io/wangyusheng1985/specboard-agent:latest
