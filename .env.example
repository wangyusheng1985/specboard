# Generate two independent secrets with: openssl rand -hex 32
API_SECRET=
ENCRYPTION_KEY=
PORT=3000
# Comma-separated exact GitLab hostnames (include port for nonstandard HTTPS).
GITLAB_ALLOWED_HOSTS=gitlab.com
PI_PROVIDER=anthropic
PI_MODEL=claude-sonnet-4-5
PI_API_KEY=
REQUEST_WINDOW_MS=60000
# Enable behind an HTTPS reverse proxy.
COOKIE_SECURE=false
