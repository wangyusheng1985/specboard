FROM golang:1.26-bookworm AS go-toolchain
FROM node:24-bookworm-slim
COPY --from=go-toolchain /usr/local/go /usr/local/go
RUN apt-get update && apt-get install -y --no-install-recommends \
    git ca-certificates python3 python3-pip python3-venv \
    && python3 -m pip install --no-cache-dir --break-system-packages ruff \
    && rm -rf /var/lib/apt/lists/* /root/.cache
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev
COPY src ./src
RUN mkdir -p /sessions /workspaces /tmp/go-cache /tmp/go-mod /tmp/go-path \
    && chown -R node:node /sessions /workspaces /tmp/go-cache /tmp/go-mod /tmp/go-path
USER node
ENV PATH="/usr/local/go/bin:${PATH}" \
    AGENT_SERVER=true \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    GOCACHE=/tmp/go-cache \
    GOMODCACHE=/tmp/go-mod \
    GOPATH=/tmp/go-path \
    GO111MODULE=on
CMD ["node","--import","tsx","src/agent-container.ts"]
